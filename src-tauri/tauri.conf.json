{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stream Clip Maker",
  "version": "0.1.0",
  "identifier": "com.kathennn.streamclipmaker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stream Clip Maker",
        "width": 1280,
        "height": 850,
        "minWidth": 940,
        "minHeight": 650,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Find stream highlights and create vertical clips.",
    "longDescription": "Discover streams, find chat reaction peaks, create vertical videos, add subtitles and upload privately.",
    "resources": {
      "resources/fontconfig/fonts.conf": "fontconfig/fonts.conf",
      "../chat-clips.mjs": "engine/chat-clips.mjs",
      "../discover-twitch.mjs": "engine/discover-twitch.mjs",
      "../desktop-engine.mjs": "engine/desktop-engine.mjs",
      "../youtube-auth.mjs": "engine/youtube-auth.mjs",
      "../youtube-upload.mjs": "engine/youtube-upload.mjs",
      "../rules.json": "engine/rules.json",
      "resources/fontconfig/README.md": "fontconfig/README.md",
      "resources/runtime/*": "runtime/",
      "../live-clips.mjs": "engine/live-clips.mjs",
      "../engine/peaks.mjs": "engine/engine/peaks.mjs",
      "../engine/live-config.mjs": "engine/engine/live-config.mjs",
      "../engine/segment-timeline.mjs": "engine/engine/segment-timeline.mjs",
      "../sources/twitch-irc.mjs": "engine/sources/twitch-irc.mjs"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
